        "weighted_message_score = messages[\"weighted_deal_signal_score\"]\n",
        "\n",
        "chat_evidence = (\n",
        "    messages.assign(\n",
        "        strongest_positive_signal=weighted_message_score.clip(lower=0),\n",
        "        strongest_negative_signal=(-weighted_message_score).clip(lower=0),\n",
        "    )\n",
        "    .groupby(\"chat_id\", as_index=False)\n",
        "    .agg(\n",
        "        scored_message_count=(\"deal_signal_score\", \"count\"),\n",
        "        strongest_positive_signal=(\"strongest_positive_signal\", \"max\"),\n",
        "        strongest_negative_signal=(\"strongest_negative_signal\", \"max\"),\n",
        "    )\n",
        ")\n",
        "\n",
        "chat_scores = chat_ids.merge(chat_evidence, on=\"chat_id\", how=\"left\", validate=\"one_to_one\")\n",
        "chat_scores[\"scored_message_count\"] = chat_scores[\"scored_message_count\"].fillna(0).astype(int)\n",
        "chat_scores[\"deal_signal_score\"] = (\n",
        "    chat_scores[\"strongest_positive_signal\"] - chat_scores[\"strongest_negative_signal\"]\n",
        ")\n",
        "chat_scores[\"deal_signal_strength\"] = chat_scores[\n",
        "    [\"strongest_positive_signal\", \"strongest_negative_signal\"]\n",
        "].max(axis=1)\n",
        "chat_scores = chat_scores.sort_values(\n",
        "    \"deal_signal_strength\", ascending=False, kind=\"stable\"\n",
        ").reset_index(drop=True)\n",
        "\n",
        "chat_scores = chat_scores[chat_scores[\"scored_message_count\"] > 0]\n",
        "chat_scores = chat_scores[chat_scores[\"strongest_positive_signal\"] > 0] \n",
        "\n",
        "chat_scores = chat_scores.sort_values(\"strongest_negative_signal\", ascending=True)\n",
        "chat_scores"
      ]
    },
