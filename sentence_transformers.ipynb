        "\n",
        "signal_weights = {\n",
        "    # POSITIVE — признаки в пользу сделки\n",
        "    \"purchase_intent\": 0.05,\n",
        "    \"seller_confirmation\": 0.05,\n",
        "    \"price_negotiation\": 0.15,\n",
        "    \"reservation\": 0.1,\n",
        "    \"meeting\": 1.5,\n",
        "    \"payment\": 1.0,\n",
        "    \"deal_confirmation\": 2.5,\n",
        "    \"item_received\": 3.0,\n",
        "\n",
        "    # NEGATIVE — признаки против сделки\n",
        "    \"buyer_refusal\": -1.5,\n",
        "    \"seller_refusal\": -1.5,\n",
        "    \"price_disagreement\": -0.7,\n",
        "    \"meeting_failure\": -1.8,\n",
        "    \"cancellation\": -1.8,\n",
        "    \"item_unavailable\": -0.6,\n",
        "    \"external_sale\": -2.5,\n",
        "    \"seller_changed_mind\": -1.8,\n",
        "    \"seller_sold\": -2.0,\n",
        "}\n",
        "\n",
        "signal_embeddings = {}\n",
        "\n",
        "for category, phrases in sale_signals.items():\n",
        "    signal_embeddings[category] = model.encode(\n",
        "        phrases,\n",
        "        normalize_embeddings=True,\n",
        "        show_progress_bar=True\n",
        "    )\n",
        "\n",
        "if messages.empty:\n",
        "    for category in signal_weights:\n",
        "        messages[category] = pd.Series(index=messages.index, dtype=float)\n",
        "else:\n",
        "    message_embeddings = model.encode(\n",
        "        messages[\"text\"].tolist(),\n",
        "        normalize_embeddings=True,\n",
        "        batch_size=128,\n",
        "        show_progress_bar=True\n",
        "    )\n",
        "    for category, embeddings in signal_embeddings.items():\n",
        "        similarities = message_embeddings @ embeddings.T\n",
        "        messages[category] = similarities.max(axis=1)\n",
        "\n",
        "\n",
        "categories = list(signal_weights.keys())\n",
        "\n",
        "# Умножаем оценки сходства на веса\n",
        "weighted_scores = messages[categories].mul(signal_weights)\n",
        "\n",
        "# Складываем веса для каждого сообщения\n",
        "messages[\"deal_signal_score\"] = weighted_scores.sum(axis=1)\n",
        "\n",
        "# Веса пяти последних сообщений каждого чата.\n",
        "recent_message_weights = {0: 3.0, 1: 2.5, 2: 2.0, 3: 1.75, 4: 1.5}\n",
        "messages[\"recency_weight\"] = recent_rank.reindex(messages.index).map(recent_message_weights)\n",
        "messages[\"weighted_deal_signal_score\"] = messages[\"deal_signal_score\"] * messages[\"recency_weight\"]\n",
        "\n",
        "messages = messages.sort_values(by=\"weighted_deal_signal_score\", ascending=False)\n",
        "messages"
      ]
    },
