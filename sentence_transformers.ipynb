      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "from sentence_transformers import SentenceTransformer\n",
        "\n",
        "messages = pd.read_csv(\"data/data_wthout_anomailes/messages_wthout_anomailes.csv\")\n",
        "\n",
        "chat_ids = messages[['chat_id']].dropna().drop_duplicates()\n",
        "\n",
        "messages[\"sent_at\"] = pd.to_datetime(messages[\"sent_at\"], errors=\"coerce\")\n",
        "# При одинаковом времени первой идёт более поздняя строка CSV.\n",
        "messages = (\n",
        "    messages.dropna(subset=[\"chat_id\", \"sent_at\"])\n",
        "    .sort_index(ascending=False)\n",
        "    .sort_values(\"sent_at\", ascending=False, kind=\"stable\")\n",
        "    .groupby(\"chat_id\", sort=False)\n",
        "    .head(5)\n",
        "    .copy()\n",
        ")\n",
        "recent_rank = messages.groupby(\"chat_id\", sort=False).cumcount()\n",
        "messages = messages.dropna(subset=[\"text\"]).copy()\n",
        "messages[\"text\"] = messages[\"text\"].astype(str)"
      ]
    },
